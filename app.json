{
  "expo": {
    "name": "Gia Sư Tập Đọc",
    "slug": "tiengviet-doc-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lab702.tiengvietdoc",
